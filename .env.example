# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty for same-origin Vercel deployment.
CORS_ORIGINS=

# Set these only in your local .env / hosting provider's secret settings.
# Never put real credentials in this example file or commit them to Git.
MONGO_DB_URL=
MONGO_DATABASE_NAME=cryptoxneuron
MONGO_CUSTOMER_COLLECTION_NAME=customers
MONGO_USER_COLLECTION_NAME=users
MONGO_ANALYSIS_HISTORY_COLLECTION_NAME=analysis_history
MONGO_SUBSCRIPTION_COLLECTION_NAME=subscriptions

# Optional. Enables the protected /train route only when set in production.
TRAINING_API_KEY=

# Keep model deserialization restricted to the application's safe classes.
MODEL_TRUSTED=1

# Required in production: generate a long random secret and set it in deployment secrets.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# Optional OAuth credentials; store real values in environment/hosting secrets only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional: canonical public origin, e.g. https://your-app.example.com
APP_BASE_URL=
# Optional: set APP_ENV=production locally in production-like environments.
APP_ENV=
